# ============================================================
#  Environment Variables for Production
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git!
# ============================================================

# Django core
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=your-ec2-ip,your-domain.com

# Database (EBS MySQL on EC2 or RDS)
DB_NAME=event_db
DB_USER=event_user
DB_PASSWORD=your-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (for Django Channels WebSocket layer)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# CORS — only allow your frontend domain
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://your-ec2-ip
